<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#262624</Color>
    <Color x:Key="PanelColor">#30302e</Color>
    <Color x:Key="PanelRaisedColor">#1f1e1d</Color>
    <Color x:Key="InputColor">#21201f</Color>
    <Color x:Key="BorderColor">#3e3d39</Color>
    <Color x:Key="TextColor">#f0eee6</Color>
    <Color x:Key="MutedColor">#9b9a90</Color>
    <Color x:Key="AccentColor">#d97757</Color>
    <Color x:Key="AmberColor">#c99752</Color>
    <Color x:Key="BlueColor">#7fa8c9</Color>
    <Color x:Key="CriticalColor">#d96c5f</Color>
    <Color x:Key="SuccessColor">#85ad6d</Color>
    <Color x:Key="SidebarColor">#1f1e1d</Color>
    <Color x:Key="HoverColor">#3a3936</Color>
    <Color x:Key="PressedColor">#454440</Color>
    <Color x:Key="SelectedColor">#493731</Color>
    <Color x:Key="GridCellColor">#3a3936</Color>
    <Color x:Key="AlternateRowColor">#2b2b29</Color>
    <Color x:Key="LevelOneColor">#31402c</Color>
    <Color x:Key="LevelTwoColor">#48613d</Color>
    <Color x:Key="LevelThreeColor">#638a51</Color>
    <Color x:Key="LevelFourColor">#82b36b</Color>
    <Color x:Key="OnAccentColor">#ffffff</Color>
    <Color x:Key="TraySurfaceColor">#F530302e</Color>
    <Color x:Key="OverlaySurfaceColor">#EB262624</Color>
    <Color x:Key="CardTipColor">#30302e</Color>
    <Color x:Key="CardTipBorderColor">#4a4944</Color>
    <Color x:Key="CardTipTextColor">#f0eee6</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="GridCellBrush" Color="{StaticResource GridCellColor}" />
    <SolidColorBrush x:Key="AlternateRowBrush" Color="{StaticResource AlternateRowColor}" />
    <SolidColorBrush x:Key="LevelOneBrush" Color="{StaticResource LevelOneColor}" />
    <SolidColorBrush x:Key="LevelTwoBrush" Color="{StaticResource LevelTwoColor}" />
    <SolidColorBrush x:Key="LevelThreeBrush" Color="{StaticResource LevelThreeColor}" />
    <SolidColorBrush x:Key="LevelFourBrush" Color="{StaticResource LevelFourColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="TraySurfaceBrush" Color="{StaticResource TraySurfaceColor}" />
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="{StaticResource OverlaySurfaceColor}" />
    <SolidColorBrush x:Key="CardTipBrush" Color="{StaticResource CardTipColor}" />
    <SolidColorBrush x:Key="CardTipBorderBrush" Color="{StaticResource CardTipBorderColor}" />
    <SolidColorBrush x:Key="CardTipTextBrush" Color="{StaticResource CardTipTextColor}" />
    <SolidColorBrush x:Key="EmptyCardBrush" Color="{StaticResource PanelRaisedColor}" Opacity="0.28" />
</ResourceDictionary>
