<Window x:Class="OhMyPc.App.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:views="clr-namespace:OhMyPc.App.Views"
        Title="Oh My PC"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="OH MY PC" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{DynamicResource App_Subtitle}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="{DynamicResource Common_Exit}" Click="Exit_Click" HorizontalContentAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="16,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    TabStripPlacement="Left">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TabPanel Grid.Column="0" IsItemsHost="True" VerticalAlignment="Top" Margin="0,92,0,0" />
                        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Margin="0,24,0,0" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="{DynamicResource Nav_Overview}">
                <views:OverviewView />
            </TabItem>

            <TabItem Header="{DynamicResource Nav_Vpn}">
                <views:VpnView />
            </TabItem>

            <TabItem Header="{DynamicResource Nav_NotificationCenter}">
                <views:NotificationCenterView />
            </TabItem>

            <TabItem Header="{DynamicResource Nav_Proxy}">
                <views:ProxyView />
            </TabItem>

            <TabItem Header="{DynamicResource Nav_Settings}">
                <views:SettingsView />
            </TabItem>
        </TabControl>

        <Border Grid.Column="1" Height="3" VerticalAlignment="Top" Background="{StaticResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Height="3" />
        </Border>

        <!-- 更新横幅：发现新版本时悬浮在内容区顶部 -->
        <Border Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12,10,0,0"
                Padding="14,8"
                CornerRadius="6"
                Background="{StaticResource AccentBrush}"
                Visibility="{Binding HasUpdateBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding UpdateBannerText}" Foreground="#14261C" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="{DynamicResource Update_InstallNow}"
                        Command="{Binding UpdateNowCommand}"
                        Margin="14,0,0,0"
                        Padding="10,4"
                        Background="#14261C"
                        Foreground="{StaticResource AccentBrush}"
                        BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
