<Window x:Class="OhMyPc.App.MainWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
         xmlns:domain="clr-namespace:OhMyPc.Core.Domain;assembly=OhMyPc.Core"
         xmlns:sys="clr-namespace:System;assembly=System.Runtime"
         xmlns:viewModels="clr-namespace:OhMyPc.App.ViewModels"
         xmlns:controls="clr-namespace:OhMyPc.App.Controls"
        Title="Oh My PC"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="OH MY PC" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{DynamicResource App_Subtitle}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="{DynamicResource Common_Exit}" Click="Exit_Click" HorizontalContentAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="16,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    TabStripPlacement="Left">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TabPanel Grid.Column="0" IsItemsHost="True" VerticalAlignment="Top" Margin="0,92,0,0" />
                        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Margin="0,24,0,0" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="{DynamicResource Nav_Overview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="28,0,28,28">
                        <Grid.RowDefinitions>
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="Auto" />
                             <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Overview_Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Overview_Description}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Overview_RefreshTooltip}" Style="{StaticResource IconButton}" Content="&#xE72C;" />
                        </Grid>

                         <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,18">
                            <Grid Height="104">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="22,0">
                                    <TextBlock Text="{DynamicResource Overview_TodayTokens}" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding TodayTokensText}" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,18" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="22,0">
                                    <TextBlock Text="{DynamicResource Overview_EstimatedCost}" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding TodayCostText}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="0,18" />
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="22,0">
                                    <TextBlock Text="{DynamicResource Overview_ActiveQuotas}" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding QuotaRows.Count}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                         </Border>

                          <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="16" Margin="0,0,0,18">
                             <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="320" />
                                 </Grid.RowDefinitions>
                                 <Grid Margin="4,0,4,14">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="Auto" />
                                         <ColumnDefinition Width="12" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                     <TextBlock Text="{DynamicResource Overview_UsageBreakdown}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                     <Border Grid.Column="1" Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="2">
                                         <StackPanel Orientation="Horizontal">
                                             <RadioButton GroupName="BreakdownGroup"
                                                          Content="{DynamicResource Overview_ByTool}"
                                                          Style="{StaticResource SegmentButton}"
                                                          IsChecked="{Binding IsBreakdownByTool, Mode=OneWay}"
                                                          Command="{Binding SelectBreakdownGroupCommand}"
                                                          CommandParameter="{x:Static domain:UsageBreakdownGroup.Tool}" />
                                             <RadioButton GroupName="BreakdownGroup"
                                                          Content="{DynamicResource Overview_ByModel}"
                                                          Style="{StaticResource SegmentButton}"
                                                          IsChecked="{Binding IsBreakdownByModel, Mode=OneWay}"
                                                          Command="{Binding SelectBreakdownGroupCommand}"
                                                          CommandParameter="{x:Static domain:UsageBreakdownGroup.Model}" />
                                         </StackPanel>
                                     </Border>
                                     <Border Grid.Column="3" Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="2">
                                         <StackPanel Orientation="Horizontal">
                                             <RadioButton GroupName="BreakdownPeriod"
                                                          Content="{DynamicResource Overview_PeriodToday}"
                                                          Style="{StaticResource SegmentButton}"
                                                          IsChecked="{Binding IsBreakdownToday, Mode=OneWay}"
                                                          Command="{Binding SelectBreakdownPeriodCommand}"
                                                          CommandParameter="{x:Static viewModels:UsageBreakdownPeriod.Today}" />
                                             <RadioButton GroupName="BreakdownPeriod"
                                                          Content="{DynamicResource Overview_PeriodMonth}"
                                                          Style="{StaticResource SegmentButton}"
                                                          IsChecked="{Binding IsBreakdownMonth, Mode=OneWay}"
                                                          Command="{Binding SelectBreakdownPeriodCommand}"
                                                          CommandParameter="{x:Static viewModels:UsageBreakdownPeriod.Month}" />
                                             <RadioButton GroupName="BreakdownPeriod"
                                                          Content="{DynamicResource Overview_PeriodAll}"
                                                          Style="{StaticResource SegmentButton}"
                                                          IsChecked="{Binding IsBreakdownAll, Mode=OneWay}"
                                                          Command="{Binding SelectBreakdownPeriodCommand}"
                                                          CommandParameter="{x:Static viewModels:UsageBreakdownPeriod.All}" />
                                         </StackPanel>
                                     </Border>
                                 </Grid>
                                 <DataGrid Grid.Row="1"
                                           ItemsSource="{Binding UsageBreakdownRows}"
                                           BorderThickness="0"
                                           RowHeight="58"
                                           CanUserSortColumns="False">
                                     <DataGrid.Columns>
                                         <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[Overview_BreakdownName]}" Width="1.5*">
                                             <DataGridTemplateColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <Grid>
                                                         <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                         <ProgressBar Grid.Row="1" Value="{Binding RelativePercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,7,10,0" />
                                                     </Grid>
                                                 </DataTemplate>
                                             </DataGridTemplateColumn.CellTemplate>
                                         </DataGridTemplateColumn>
                                         <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[Overview_BreakdownTotal]}" Width="1.05*">
                                             <DataGridTemplateColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <StackPanel HorizontalAlignment="Right">
                                                         <TextBlock Text="{Binding TotalTokensText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                         <TextBlock Text="{Binding CostText}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </DataGridTemplateColumn.CellTemplate>
                                         </DataGridTemplateColumn>
                                         <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Overview_BreakdownInput]}" Binding="{Binding InputTokensText}" Width="1.05*" ElementStyle="{StaticResource BreakdownNumberCell}" />
                                         <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Overview_BreakdownOutput]}" Binding="{Binding OutputTokensText}" Width="1.05*" ElementStyle="{StaticResource BreakdownNumberCell}" />
                                         <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[Overview_BreakdownCacheHit]}" Width="1.15*">
                                             <DataGridTemplateColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <StackPanel HorizontalAlignment="Right">
                                                         <TextBlock Text="{Binding CacheHitTokensText}" HorizontalAlignment="Right" />
                                                         <TextBlock Text="{Binding CacheHitPercentText}" Foreground="{StaticResource AccentBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </DataGridTemplateColumn.CellTemplate>
                                         </DataGridTemplateColumn>
                                     </DataGrid.Columns>
                                 </DataGrid>
                             </Grid>
                         </Border>

                          <Border Grid.Row="3" Style="{StaticResource PanelCard}" Padding="16" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,4,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Overview_DailyActivity}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding ContributionRangeText}" Style="{StaticResource MutedText}" FontSize="11" />
                                </Grid>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="108" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ContributionMonths}" Width="{Binding ContributionGridWidth}" Height="20">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas IsItemsHost="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}" /></Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Text}" Style="{StaticResource MutedText}" FontSize="10" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Canvas Grid.Row="1" Width="30" Height="108">
                                            <TextBlock Canvas.Top="0" Text="{DynamicResource Overview_MondayShort}" Style="{StaticResource MutedText}" FontSize="10" />
                                            <TextBlock Canvas.Top="32" Text="{DynamicResource Overview_WednesdayShort}" Style="{StaticResource MutedText}" FontSize="10" />
                                            <TextBlock Canvas.Top="64" Text="{DynamicResource Overview_FridayShort}" Style="{StaticResource MutedText}" FontSize="10" />
                                        </Canvas>
                                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ContributionDays}" Width="{Binding ContributionGridWidth}" Height="108">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas IsItemsHost="True" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><Border Style="{StaticResource ContributionCell}" ToolTip="{Binding Tooltip}" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource Overview_Less}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                             <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource GridCellBrush}" Margin="0,0,4,0" />
                                             <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource LevelOneBrush}" Margin="0,0,4,0" />
                                             <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource LevelTwoBrush}" Margin="0,0,4,0" />
                                             <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource LevelThreeBrush}" Margin="0,0,4,0" />
                                             <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource LevelFourBrush}" />
                                            <TextBlock Text="{DynamicResource Overview_More}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                          <Border Grid.Row="4" Style="{StaticResource PanelCard}" Padding="16" Margin="0,0,0,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="250" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="125" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource Overview_WeeklyCandles}" FontWeight="SemiBold" Margin="4,0,0,8" />
                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding WeeklyUsageSeries}"
                                                     XAxes="{Binding WeeklyUsageXAxes}"
                                                     YAxes="{Binding WeeklyUsageYAxes}"
                                                     DrawMargin="{Binding WeeklyChartDrawMargin}"
                                                     Background="{StaticResource PanelBrush}"
                                                    LegendPosition="Hidden"
                                                    DrawMarginFrame="{x:Null}" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource Overview_WeeklyMessages}" FontWeight="SemiBold" Margin="4,12,0,2" />
                                <lvc:CartesianChart Grid.Row="3"
                                                    Series="{Binding WeeklyMessageSeries}"
                                                     XAxes="{Binding WeeklyMessageXAxes}"
                                                     YAxes="{Binding WeeklyMessageYAxes}"
                                                     DrawMargin="{Binding WeeklyChartDrawMargin}"
                                                     Background="{StaticResource PanelBrush}"
                                                    LegendPosition="Hidden"
                                                    DrawMarginFrame="{x:Null}" />
                            </Grid>
                        </Border>

                          <Grid Grid.Row="5" Margin="0,0,0,12">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                              <StackPanel>
                                  <TextBlock Text="{DynamicResource Overview_CurrentQuotas}" Style="{StaticResource SectionTitle}" />
                                  <TextBlock Text="{DynamicResource Overview_CurrentQuotasDescription}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                              </StackPanel>
                              <Button Grid.Column="1"
                                      Content="{DynamicResource Sources_ImportEnvironment}"
                                      Click="ImportEnvironment_Click"
                                      ToolTip="{DynamicResource Sources_ImportEnvironmentTooltip}"
                                      VerticalAlignment="Bottom" />
                          </Grid>
                          <ItemsControl Grid.Row="6" ItemsSource="{Binding QuotaCards}">
                              <ItemsControl.Resources>
                                  <DataTemplate DataType="{x:Type viewModels:QuotaSourceCardViewModel}">
                                      <Border Style="{StaticResource QuotaCard}">
                                          <Grid>
                                              <Grid.RowDefinitions>
                                                  <RowDefinition Height="Auto" />
                                                  <RowDefinition Height="Auto" />
                                                  <RowDefinition Height="*" />
                                                  <RowDefinition Height="Auto" />
                                                  <RowDefinition Height="Auto" />
                                              </Grid.RowDefinitions>
                                              <Grid>
                                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                  <StackPanel>
                                                      <TextBlock Text="{Binding SourceName}" Style="{StaticResource CardTitle}" />
                                                      <TextBlock Text="{Binding ProviderTypeText}" Style="{StaticResource CardMeta}" Margin="0,3,0,0" />
                                                  </StackPanel>
                                                  <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource CardMeta}" VerticalAlignment="Top" />
                                              </Grid>
                                              <TextBlock Grid.Row="1" Text="{Binding EndpointText}" Style="{StaticResource CardMeta}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                              <Grid Grid.Row="2" Margin="0,2,0,10">
                                                  <ItemsControl ItemsSource="{Binding Quotas}">
                                                      <ItemsControl.ItemTemplate>
                                                          <DataTemplate>
                                                              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                                                                  <Grid>
                                                                      <Grid.RowDefinitions>
                                                                          <RowDefinition Height="Auto" />
                                                                          <RowDefinition Height="Auto" />
                                                                          <RowDefinition Height="Auto" />
                                                                      </Grid.RowDefinitions>
                                                                      <Grid>
                                                                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                          <StackPanel>
                                                                              <TextBlock Text="{Binding Label}" Style="{StaticResource CardMeta}" />
                                                                              <TextBlock Text="{Binding UsedText}" FontSize="11" Margin="0,2,0,0" />
                                                                          </StackPanel>
                                                                          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                              <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                                              <TextBlock Text="{Binding RemainingText}" Style="{StaticResource CardMeta}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                                          </StackPanel>
                                                                      </Grid>
                                                                      <ProgressBar Grid.Row="1" Value="{Binding RemainingPercent, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" />
                                                                      <TextBlock Grid.Row="2" Text="{Binding ResetText}" Style="{StaticResource CardMeta}" Margin="0,4,0,0" />
                                                                  </Grid>
                                                              </Border>
                                                          </DataTemplate>
                                                      </ItemsControl.ItemTemplate>
                                                  </ItemsControl>
                                                  <TextBlock Text="{DynamicResource Quota_NoCurrentData}" VerticalAlignment="Center">
                                                      <TextBlock.Style>
                                                          <Style TargetType="TextBlock" BasedOn="{StaticResource CardMeta}">
                                                              <Setter Property="Visibility" Value="Collapsed" />
                                                              <Style.Triggers>
                                                                  <DataTrigger Binding="{Binding HasQuotas}" Value="False">
                                                                      <Setter Property="Visibility" Value="Visible" />
                                                                  </DataTrigger>
                                                              </Style.Triggers>
                                                          </Style>
                                                      </TextBlock.Style>
                                                  </TextBlock>
                                              </Grid>
                                              <Border Grid.Row="3"
                                                      BorderBrush="{StaticResource BorderBrush}"
                                                      BorderThickness="0,1,0,0"
                                                      Padding="0,10,0,0"
                                                      Margin="0,0,0,10">
                                                  <Border.Style>
                                                      <Style TargetType="Border">
                                                          <Setter Property="Visibility" Value="Collapsed" />
                                                          <Style.Triggers>
                                                              <DataTrigger Binding="{Binding HasModelStatusEndpoint}" Value="True">
                                                                  <Setter Property="Visibility" Value="Visible" />
                                                              </DataTrigger>
                                                          </Style.Triggers>
                                                      </Style>
                                                  </Border.Style>
                                                  <StackPanel>
                                                      <Grid>
                                                          <Grid.ColumnDefinitions>
                                                              <ColumnDefinition Width="*" />
                                                              <ColumnDefinition Width="Auto" />
                                                              <ColumnDefinition Width="Auto" />
                                                          </Grid.ColumnDefinitions>
                                                          <TextBlock Text="{DynamicResource ModelStatus_Title}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                          <TextBlock Grid.Column="1" Text="{Binding ModelStatusUpdatedText}" Style="{StaticResource CardMeta}" FontSize="10" VerticalAlignment="Center" Margin="8,0,4,0" />
                                                          <Button Grid.Column="2"
                                                                  Content="&#xE72C;"
                                                                  Style="{StaticResource CardActionButton}"
                                                                  ToolTip="{DynamicResource ModelStatus_RefreshTooltip}"
                                                                  Click="RefreshModelStatus_Click" />
                                                      </Grid>
                                                      <TextBlock Text="{Binding ModelStatusError}"
                                                                 Foreground="{StaticResource CriticalBrush}"
                                                                 FontSize="10"
                                                                 TextTrimming="CharacterEllipsis"
                                                                 ToolTip="{Binding ModelStatusError}"
                                                                 Margin="0,5,0,0">
                                                          <TextBlock.Style>
                                                              <Style TargetType="TextBlock">
                                                                  <Setter Property="Visibility" Value="Collapsed" />
                                                                  <Style.Triggers>
                                                                      <DataTrigger Binding="{Binding HasModelStatusError}" Value="True">
                                                                          <Setter Property="Visibility" Value="Visible" />
                                                                      </DataTrigger>
                                                                  </Style.Triggers>
                                                              </Style>
                                                          </TextBlock.Style>
                                                      </TextBlock>
                                                      <TextBlock Text="{DynamicResource ModelStatus_Waiting}" Margin="0,8,0,0">
                                                          <TextBlock.Style>
                                                              <Style TargetType="TextBlock" BasedOn="{StaticResource CardMeta}">
                                                                  <Setter Property="Visibility" Value="Collapsed" />
                                                                  <Style.Triggers>
                                                                      <DataTrigger Binding="{Binding ShowModelStatusWaiting}" Value="True">
                                                                          <Setter Property="Visibility" Value="Visible" />
                                                                      </DataTrigger>
                                                                  </Style.Triggers>
                                                              </Style>
                                                          </TextBlock.Style>
                                                      </TextBlock>
                                                      <ItemsControl ItemsSource="{Binding ModelStatuses}" Margin="0,4,0,0">
                                                          <ItemsControl.ItemTemplate>
                                                              <DataTemplate>
                                                                  <StackPanel Margin="0,6,0,2" ToolTip="{Binding ErrorText}">
                                                                      <Grid>
                                                                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                          <TextBlock Text="{Binding Model}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                              <Ellipse Width="7" Height="7" Margin="0,0,5,0">
                                                                                  <Ellipse.Style>
                                                                                      <Style TargetType="Ellipse">
                                                                                          <Setter Property="Fill" Value="{StaticResource CriticalBrush}" />
                                                                                          <Style.Triggers>
                                                                                              <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                                                  <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                                              </DataTrigger>
                                                                                          </Style.Triggers>
                                                                                      </Style>
                                                                                  </Ellipse.Style>
                                                                              </Ellipse>
                                                                              <TextBlock Text="{Binding StatusText}" FontSize="10">
                                                                                  <TextBlock.Style>
                                                                                      <Style TargetType="TextBlock">
                                                                                          <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                                                          <Style.Triggers>
                                                                                              <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                                                  <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                                              </DataTrigger>
                                                                                          </Style.Triggers>
                                                                                      </Style>
                                                                                  </TextBlock.Style>
                                                                              </TextBlock>
                                                                          </StackPanel>
                                                                      </Grid>
                                                                      <Grid Margin="0,4,0,0">
                                                                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                          <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CardMeta}" FontSize="10" />
                                                                          <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Style="{StaticResource CardMeta}" FontSize="10" />
                                                                      </Grid>
                                                                      <ItemsControl ItemsSource="{Binding Samples}" Margin="0,6,0,0">
                                                                          <ItemsControl.ItemsPanel>
                                                                              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                          </ItemsControl.ItemsPanel>
                                                                          <ItemsControl.ItemTemplate>
                                                                              <DataTemplate>
                                                                                  <Border Width="9" Height="7" Margin="0,0,3,0" CornerRadius="1">
                                                                                      <Border.Style>
                                                                                          <Style TargetType="Border">
                                                                                              <Setter Property="Background" Value="{StaticResource GridCellBrush}" />
                                                                                              <Style.Triggers>
                                                                                                  <DataTrigger Binding="{Binding Available}" Value="True">
                                                                                                      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                                                  </DataTrigger>
                                                                                                  <DataTrigger Binding="{Binding Available}" Value="False">
                                                                                                      <Setter Property="Background" Value="{StaticResource CriticalBrush}" />
                                                                                                  </DataTrigger>
                                                                                              </Style.Triggers>
                                                                                          </Style>
                                                                                      </Border.Style>
                                                                                  </Border>
                                                                              </DataTemplate>
                                                                          </ItemsControl.ItemTemplate>
                                                                      </ItemsControl>
                                                                  </StackPanel>
                                                              </DataTemplate>
                                                          </ItemsControl.ItemTemplate>
                                                      </ItemsControl>
                                                  </StackPanel>
                                              </Border>
                                              <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                  <Button Content="&#xE70F;"
                                                          Style="{StaticResource CardActionButton}"
                                                          ToolTip="{DynamicResource Common_EditTooltip}"
                                                          Click="EditQuotaSource_Click" />
                                                  <Button Content="&#xE74D;"
                                                          Style="{StaticResource CardActionButton}"
                                                          ToolTip="{DynamicResource Common_DeleteTooltip}"
                                                          Click="DeleteQuotaSource_Click" />
                                              </StackPanel>
                                          </Grid>
                                      </Border>
                                  </DataTemplate>
                                  <DataTemplate DataType="{x:Type viewModels:AddQuotaSourceCardViewModel}">
                                      <Button Style="{StaticResource AddCardButton}" Click="AddSource_Click">
                                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                              <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                              <TextBlock Text="{DynamicResource Sources_AddCard}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                              <TextBlock Text="{DynamicResource Sources_AddCardDescription}" Style="{StaticResource CardMeta}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                          </StackPanel>
                                      </Button>
                                  </DataTemplate>
                              </ItemsControl.Resources>
                              <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                      <controls:MasonryPanel IsItemsHost="True"
                                                              ColumnWidth="290"
                                                              HorizontalSpacing="12"
                                                              VerticalSpacing="12" />
                                  </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                          </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Nav_Vpn}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <Grid Margin="28,0,28,28" MaxWidth="900" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Vpn_Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Vpn_Description}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="ConnectVpn_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="{DynamicResource Vpn_Connect}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vpn.HasAccount}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource Vpn_Reconnect}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding Vpn.RefreshCommand}"
                                    Content="&#xE72C;"
                                    ToolTip="{DynamicResource Vpn_RefreshTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vpn.IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="5"
                                    Click="RemoveVpn_Click"
                                    Content="&#xE74D;"
                                    ToolTip="{DynamicResource Vpn_RemoveTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vpn.IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vpn.HasAccount}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Vpn_EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock Text="{DynamicResource Vpn_EmptyDescription}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>

                            <Border Grid.Row="0" Padding="24">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PanelCard}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vpn.IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="28" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Vpn.PlanName}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Vpn.Email}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Vpn.StatusText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Top" />
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Vpn_Remaining}" Style="{StaticResource MutedText}" FontSize="11" />
                                            <TextBlock Text="{Binding Vpn.RemainingText}" FontSize="32" FontWeight="SemiBold" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Vpn.RemainingPercentText}" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                    </Grid>
                                    <ProgressBar Grid.Row="4" Value="{Binding Vpn.RemainingPercent, Mode=OneWay}" Maximum="100" Height="8" />

                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Vpn_Total}" Style="{StaticResource MutedText}" FontSize="11" />
                                            <TextBlock Text="{Binding Vpn.TotalText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,-2,0,-2" />
                                        <StackPanel Grid.Column="2" Margin="18,0">
                                            <TextBlock Text="{DynamicResource Vpn_Used}" Style="{StaticResource MutedText}" FontSize="11" />
                                            <TextBlock Text="{Binding Vpn.UsedText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="0,-2,0,-2" />
                                        <StackPanel Grid.Column="4" Margin="18,0">
                                            <TextBlock Text="{DynamicResource Vpn_Uploaded}" Style="{StaticResource MutedText}" FontSize="11" />
                                            <TextBlock Text="{Binding Vpn.UploadedText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="5" Background="{StaticResource BorderBrush}" Margin="0,-2,0,-2" />
                                        <StackPanel Grid.Column="6" Margin="18,0,0,0">
                                            <TextBlock Text="{DynamicResource Vpn_Downloaded}" Style="{StaticResource MutedText}" FontSize="11" />
                                            <TextBlock Text="{Binding Vpn.DownloadedText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Vpn_Expires}" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding Vpn.ExpiresText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{DynamicResource Vpn_DaysLabel}" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding Vpn.DaysRemainingText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="{DynamicResource Vpn_ResetDay}" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding Vpn.ResetDayText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1">
                                                <TextBlock Text="{DynamicResource Vpn_LastUpdated}" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding Vpn.LastUpdatedText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="9" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="3,0,0,0" Background="{StaticResource PanelRaisedBrush}" Padding="12,9" Margin="0,20,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Vpn.HasError}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Vpn.ErrorText}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Padding="16" Margin="0,18,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PanelCard}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vpn.IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="220" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="4,0,4,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Vpn_HistoryTitle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Vpn.HistoryRangeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <StackPanel Margin="18,0,0,0">
                                                <TextBlock Text="{DynamicResource Vpn_AverageDaily}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Vpn.AverageDailyText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="18,0,0,0">
                                                <TextBlock Text="{DynamicResource Vpn_EstimatedExhaustion}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Vpn.EstimatedExhaustionText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <lvc:CartesianChart Series="{Binding Vpn.DailyUsageSeries}"
                                                            XAxes="{Binding Vpn.DailyUsageXAxes}"
                                                            YAxes="{Binding Vpn.DailyUsageYAxes}"
                                                            DrawMargin="{Binding Vpn.DailyUsageDrawMargin}"
                                                            Background="{StaticResource PanelBrush}"
                                                            LegendPosition="Hidden"
                                                            DrawMarginFrame="{x:Null}" />
                                        <TextBlock Text="{DynamicResource Vpn_NotEnoughHistory}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Vpn.HasHistory}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Nav_NotificationCenter}">
                <Grid Margin="28,0,28,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource NotificationCenter_Title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource NotificationCenter_Description}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{DynamicResource NotificationCenter_HistoryTab}"
                                             GroupName="NotificationCenterSection"
                                             Style="{StaticResource SegmentButton}"
                                             IsChecked="{Binding NotificationCenter.IsHistorySelected, Mode=TwoWay}" />
                                <RadioButton Content="{DynamicResource NotificationCenter_RulesTab}"
                                             GroupName="NotificationCenterSection"
                                             Style="{StaticResource SegmentButton}"
                                             IsChecked="{Binding NotificationCenter.IsRulesSelected, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding NotificationCenter.HistoryCountText}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding NotificationCenter.IsHistorySelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <Grid Grid.Row="2"
                          Visibility="{Binding NotificationCenter.IsHistorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding NotificationCenter.SourceOptions}"
                                      SelectedItem="{Binding NotificationCenter.SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="NotificationFilter_SelectionChanged"
                                      ToolTip="{DynamicResource NotificationCenter_SourceFilter}" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding NotificationCenter.SeverityOptions}"
                                      SelectedItem="{Binding NotificationCenter.SelectedSeverity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="NotificationFilter_SelectionChanged"
                                      ToolTip="{DynamicResource NotificationCenter_SeverityFilter}" />
                            <ComboBox Grid.Column="4"
                                      ItemsSource="{Binding NotificationCenter.PeriodOptions}"
                                      SelectedItem="{Binding NotificationCenter.SelectedPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="NotificationFilter_SelectionChanged"
                                      ToolTip="{DynamicResource NotificationCenter_PeriodFilter}" />
                            <Button Grid.Column="6"
                                    Content="&#xE72C;"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="{DynamicResource NotificationCenter_RefreshTooltip}"
                                    Click="RefreshNotificationHistory_Click" />
                            <Button Grid.Column="8"
                                    Content="&#xE768;"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="{DynamicResource NotificationCenter_ReplayTooltip}"
                                    IsEnabled="{Binding NotificationCenter.HasSelectedNotification}"
                                    Click="ReplayNotification_Click" />
                            <Button Grid.Column="10"
                                    Content="&#xE74D;"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="{DynamicResource NotificationCenter_DeleteTooltip}"
                                    IsEnabled="{Binding NotificationCenter.HasSelectedNotification}"
                                    Click="DeleteNotification_Click" />
                            <Button Grid.Column="12"
                                    Content="{DynamicResource NotificationCenter_ClearAll}"
                                    Style="{StaticResource DangerButton}"
                                    Click="ClearNotificationHistory_Click" />
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource CriticalBrush}"
                                BorderThickness="3,0,0,0"
                                Background="{StaticResource PanelRaisedBrush}"
                                Padding="12,9"
                                Margin="0,0,0,12"
                                Visibility="{Binding NotificationCenter.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding NotificationCenter.ErrorText}" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="2">
                            <DataGrid ItemsSource="{Binding NotificationCenter.Notifications}"
                                      SelectedItem="{Binding NotificationCenter.SelectedNotification, Mode=TwoWay}"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_Time]}"
                                                        Binding="{Binding CreatedAtText}"
                                                        Width="148" />
                                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_Source]}"
                                                        Binding="{Binding SourceText}"
                                                        Width="170" />
                                    <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_Severity]}" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static domain:NotificationSeverity.Warning}">
                                                                        <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static domain:NotificationSeverity.Critical}">
                                                                        <Setter Property="Fill" Value="{StaticResource CriticalBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding SeverityText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_TitleColumn]}" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_Body]}" Width="1.7*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Body}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Channels]}"
                                                        Binding="{Binding ChannelsText}"
                                                        Width="118" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding NotificationCenter.IsHistoryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource NotificationCenter_Empty}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                Style="{StaticResource PanelCard}"
                                Padding="14,12"
                                Margin="0,12,0,0"
                                MaxHeight="150"
                                Visibility="{Binding NotificationCenter.HasSelectedNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding NotificationCenter.SelectedNotification.Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NotificationCenter.SelectedNotification.CreatedAtText}"
                                               Style="{StaticResource MutedText}"
                                               Margin="16,0,0,0" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding NotificationCenter.SelectedNotification.Body}" TextWrapping="Wrap" Margin="0,0,18,0" />
                                    </ScrollViewer>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding NotificationCenter.SelectedNotification.SourceText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NotificationCenter.SelectedNotification.SeverityText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding NotificationCenter.SelectedNotification.ChannelsText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          Visibility="{Binding NotificationCenter.IsRulesSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource NotificationCenter_RulesDescription}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{DynamicResource Rules_Add}" Click="AddRule_Click" Style="{StaticResource PrimaryButton}" />
                            <Button Grid.Column="3" Content="{DynamicResource Common_Edit}" Click="EditRule_Click" IsEnabled="{Binding NotificationCenter.HasSelectedRule}" />
                            <Button Grid.Column="5" Content="{DynamicResource Common_Delete}" Click="DeleteRule_Click" Style="{StaticResource DangerButton}" IsEnabled="{Binding NotificationCenter.HasSelectedRule}" />
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding NotificationCenter.Rules}" SelectedItem="{Binding NotificationCenter.SelectedRule, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Common_Name]}" Binding="{Binding Converter={StaticResource LocalizedRuleNameConverter}}" Width="1.5*" />
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Event]}" Binding="{Binding EventType, Converter={StaticResource LocalizedAutomationEventConverter}}" Width="1.25*" />
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Conditions]}" Binding="{Binding Converter={StaticResource AutomationConditionsConverter}}" Width="2.3*" />
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Channels]}" Binding="{Binding Converter={StaticResource AutomationChannelsConverter}}" Width="1.1*" />
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Cooldown]}" Binding="{Binding CooldownMinutes}" Width="140" />
                                <DataGridCheckBoxColumn Header="{Binding Source={StaticResource Localization}, Path=[Common_Enabled]}" Binding="{Binding Enabled}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Nav_Proxy}">
                <Grid Margin="28,0,28,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Proxy_Title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource Proxy_Description}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>

                    <!-- 未安装：安装引导 -->
                    <Border Grid.Row="1"
                            Style="{StaticResource PanelCard}"
                            Padding="18,16"
                            Margin="0,0,0,16"
                            Visibility="{Binding Proxy.IsNotInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Proxy_SetupTitle}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{DynamicResource Proxy_SetupHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox Content="{DynamicResource Proxy_Migrate}"
                                          IsChecked="{Binding Proxy.MigrateFromEasyCpa}"
                                          IsEnabled="{Binding Proxy.CanMigrate}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0" />
                                <Button Content="{DynamicResource Proxy_Install}"
                                        Command="{Binding Proxy.InstallCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,0" />
                                <Button Content="{DynamicResource Proxy_Redetect}" Command="{Binding Proxy.RedetectCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Proxy.InstallStatusText}"
                                       Foreground="{StaticResource CriticalBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Visibility="{Binding Proxy.HasInstallError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <!-- 已安装：服务状态条 -->
                    <Border Grid.Row="1"
                            Style="{StaticResource PanelCard}"
                            Padding="16,10"
                            Margin="0,0,0,12"
                            Visibility="{Binding Proxy.IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Proxy.IsRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Proxy.IsStarting}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Proxy.StateText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Proxy.VersionText}" Style="{StaticResource MutedText}" Margin="18,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Proxy.ModelCountText}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Proxy.BaseUrlText}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Button Grid.Column="4" Content="{DynamicResource Proxy_Start}" Command="{Binding Proxy.StartCommand}" />
                            <Button Grid.Column="6" Content="{DynamicResource Proxy_Stop}" Command="{Binding Proxy.StopCommand}" />
                            <Button Grid.Column="8" Content="{DynamicResource Proxy_Restart}" Command="{Binding Proxy.RestartCommand}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Proxy.OperationText}"
                               Foreground="{StaticResource CriticalBrush}"
                               FontSize="12"
                               Margin="0,0,0,10"
                               VerticalAlignment="Bottom"
                               Visibility="{Binding Proxy.HasOperationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- 二级分段：上游 Provider / 路由与接入 / 客户端同步 -->
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{DynamicResource Proxy_ProvidersTab}"
                                             GroupName="ProxySection"
                                             Style="{StaticResource SegmentButton}"
                                             IsChecked="{Binding Proxy.IsProvidersSelected, Mode=TwoWay}" />
                                <RadioButton Content="{DynamicResource Proxy_UnifiedTab}"
                                             GroupName="ProxySection"
                                             Style="{StaticResource SegmentButton}"
                                             IsChecked="{Binding Proxy.IsUnifiedSelected, Mode=TwoWay}" />
                                <RadioButton Content="{DynamicResource Proxy_RoutingTab}"
                                             GroupName="ProxySection"
                                             Style="{StaticResource SegmentButton}"
                                             IsChecked="{Binding Proxy.IsRoutingSelected, Mode=TwoWay}" />
                                <RadioButton Content="{DynamicResource Proxy_ClientsTab}"
                                             GroupName="ProxySection"
                                             Style="{StaticResource SegmentButton}"
                                             IsChecked="{Binding Proxy.IsClientsSelected, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="2"
                                Content="{DynamicResource Proxy_SaveConfig}"
                                Command="{Binding Proxy.SaveConfigCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </Grid>

                    <!-- 上游 Provider -->
                    <Grid Grid.Row="3"
                          Visibility="{Binding Proxy.IsProvidersSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="10">
                            <DockPanel>
                                <Border DockPanel.Dock="Bottom"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,10,0,0"
                                        Padding="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{DynamicResource Proxy_AddClaude}" Command="{Binding Proxy.AddClaudeCommand}" Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource Proxy_AddCodex}" Command="{Binding Proxy.AddCodexCommand}" Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource Common_Delete}" Click="DeleteProxyProvider_Click" Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                </Border>
                                <ListBox ItemsSource="{Binding Proxy.Providers}"
                                         SelectedItem="{Binding Proxy.SelectedProvider, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource AppCardListBoxItem}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ModelCountText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding BaseUrl}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding Proxy.HasSelectedProvider}">
                                <Border Style="{StaticResource PanelCard}" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Label Content="{DynamicResource Proxy_Remark}" />
                                                <TextBox Text="{Binding Proxy.SelectedProvider.Remark, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label Content="{DynamicResource Proxy_Priority}" />
                                                <TextBox Text="{Binding Proxy.SelectedProvider.PriorityText, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,0,0,10">
                                            <Label Content="{DynamicResource Proxy_ApiKey}" />
                                            <TextBox Text="{Binding Proxy.SelectedProvider.ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <Label Content="{DynamicResource Proxy_BaseUrl}" />
                                            <TextBox Text="{Binding Proxy.SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Proxy_Models}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{DynamicResource Proxy_FetchModels}" Click="FetchProxyModels_Click" Style="{StaticResource PrimaryButton}" />
                                    <Button Grid.Column="3" Content="{DynamicResource Proxy_AddModel}" Click="AddProxyModel_Click" />
                                    <Button Grid.Column="5" Content="{DynamicResource Common_Edit}" Click="EditProxyModel_Click" IsEnabled="{Binding Proxy.SelectedProvider.HasSelectedModel}" />
                                    <Button Grid.Column="7" Content="{DynamicResource Common_Delete}" Click="DeleteProxyModel_Click" Style="{StaticResource DangerButton}" IsEnabled="{Binding Proxy.SelectedProvider.HasSelectedModel}" />
                                </Grid>

                                <DataGrid ItemsSource="{Binding Proxy.SelectedProvider.Models}"
                                          SelectedItem="{Binding Proxy.SelectedProvider.SelectedModel, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          MinHeight="160"
                                          MaxHeight="320"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnModel]}"
                                                            Binding="{Binding Name}"
                                                            Width="1.2*" />
                                        <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnAlias]}"
                                                            Binding="{Binding Alias}"
                                                            Width="1.2*" />
                                        <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnContext]}"
                                                            Binding="{Binding ContextText}"
                                                            Width="90" />
                                        <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnLevels]}"
                                                            Binding="{Binding LevelsText}"
                                                            Width="1.1*" />
                                        <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnModalities]}"
                                                            Binding="{Binding ModalitiesText}"
                                                            Width="1.2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 模型统一配置 -->
                    <Grid Grid.Row="3"
                          Visibility="{Binding Proxy.IsUnifiedSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Proxy_UnifiedHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Grid.Column="1"
                                    Content="{DynamicResource Common_Edit}"
                                    Click="EditUnifiedModel_Click"
                                    IsEnabled="{Binding Proxy.HasSelectedUnifiedModel}"
                                    Style="{StaticResource PrimaryButton}" />
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Proxy.UnifiedModels}"
                                  SelectedItem="{Binding Proxy.SelectedUnifiedModel, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnModel]}"
                                                    Binding="{Binding Name}"
                                                    Width="1.6*" />
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_UnifiedProviderCount]}"
                                                    Binding="{Binding ProviderCount}"
                                                    Width="96" />
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnContext]}"
                                                    Binding="{Binding ContextText}"
                                                    Width="100" />
                                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnLevels]}"
                                                    Binding="{Binding LevelsText}"
                                                    Width="1.2*" />
                                <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_UnifiedConsistency]}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{DynamicResource Proxy_UnifiedInconsistent}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInconsistent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 路由与接入 -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Proxy.IsRoutingSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Style="{StaticResource PanelCard}" Padding="20,16" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Proxy_RoutingStrategy}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Proxy.SelectedStrategy}" SelectedValuePath="Tag">
                                        <ComboBoxItem Tag="round-robin" Content="{DynamicResource Proxy_StrategyRoundRobin}" />
                                        <ComboBoxItem Tag="weighted-round-robin" Content="{DynamicResource Proxy_StrategyWeighted}" />
                                        <ComboBoxItem Tag="fill-first" Content="{DynamicResource Proxy_StrategyFillFirst}" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox Content="{DynamicResource Proxy_SessionAffinity}"
                                          IsChecked="{Binding Proxy.SessionAffinity}"
                                          Margin="0,0,0,14" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Proxy_RequestRetry}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Proxy.RequestRetryText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="240" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Proxy_MaxRetryInterval}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBox Grid.Column="1" Text="{Binding Proxy.MaxRetryIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <StackPanel Margin="0,0,0,16">
                                    <Label Content="{DynamicResource Proxy_ApiKeys}" />
                                    <TextBox Text="{Binding Proxy.ApiKeysText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Height="86" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Proxy_ServiceAddress}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Proxy.BaseUrlText}" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- 客户端同步 -->
                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Proxy.IsClientsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Proxy_ClientsIntro}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Proxy.Clients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PanelCard}" Padding="16,14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding ConfigFileText}"
                                                               Style="{StaticResource MutedText}"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel>
                                                        <Label Content="{DynamicResource Proxy_DefaultModel}" />
                                                        <ComboBox ItemsSource="{Binding Models}"
                                                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                                                  DisplayMemberPath="Display" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Label Content="{DynamicResource Proxy_DefaultEffort}" />
                                                        <ComboBox ItemsSource="{Binding Efforts}"
                                                                  SelectedItem="{Binding SelectedEffort, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="4"
                                                            Grid.RowSpan="2"
                                                            Content="{DynamicResource Proxy_Sync}"
                                                            Command="{Binding DataContext.Proxy.SyncClientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Client}"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource PrimaryButton}" />
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="5"
                                                               Text="{Binding LastSyncText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="12"
                                                               Margin="0,10,0,0"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Nav_Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28,0,28,28"
                          MaxWidth="760"
                          HorizontalAlignment="Left"
                          IsEnabled="{Binding CanEditSettings}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{DynamicResource Settings_Title}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource Settings_Description}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,18" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Application}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_ApplicationDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,24,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Settings_Language}" Margin="0,0,0,6" />
                                    <ComboBox SelectedValue="{Binding Settings.Language}" SelectedValuePath="Tag" Width="180" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <ComboBoxItem Tag="zh-CN" Content="{DynamicResource Language_ZhCN}" />
                                        <ComboBoxItem Tag="en-US" Content="{DynamicResource Language_EnUS}" />
                                    </ComboBox>
                                    <CheckBox Content="{DynamicResource Settings_StartWithWindows}" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,0,0,12" />
                                    <CheckBox Content="{DynamicResource Settings_CliProxyAutoStart}" IsChecked="{Binding Settings.CliProxyAutoStart}" Margin="0,0,0,12" />
                                    <CheckBox Content="{DynamicResource Settings_EnableNotifications}" IsChecked="{Binding Settings.NotificationsEnabled}" />
                                    <TextBlock Text="{DynamicResource Settings_NotificationRetention}" Margin="0,16,0,6" />
                                    <ComboBox SelectedValue="{Binding Settings.NotificationHistoryRetentionDays, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              Width="180"
                                              HorizontalAlignment="Left">
                                        <ComboBoxItem Content="{DynamicResource Settings_Retention7Days}">
                                            <ComboBoxItem.Tag><sys:Int32>7</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{DynamicResource Settings_Retention30Days}">
                                            <ComboBoxItem.Tag><sys:Int32>30</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="{DynamicResource Settings_Retention90Days}">
                                            <ComboBoxItem.Tag><sys:Int32>90</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_Danmaku}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_DanmakuDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,24,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox Content="{DynamicResource Settings_EnableDanmaku}" IsChecked="{Binding Settings.DanmakuEnabled}" Margin="0,0,0,14" />
                                    <Grid Grid.Row="1" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_Opacity}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Settings.DanmakuOpacity, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_Speed}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Settings.DanmakuSpeed, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_FontSize}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Settings.DanmakuFontSize, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_MaxDuration}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Settings.DanmakuDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_LocalApi}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_LocalApiDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,24,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox Content="{DynamicResource Settings_EnableLocalApi}" IsChecked="{Binding Settings.LocalApiEnabled}" Margin="0,0,0,14" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings_LocalApiPort}" VerticalAlignment="Center" />
                                        <TextBox x:Name="LocalApiPortBox"
                                                 Grid.Column="1"
                                                 Text="{Binding Settings.LocalApiPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Settings_LocalApiEndpoint}" Style="{StaticResource MutedText}" FontSize="11" />
                                    <TextBlock Text="{Binding LocalApiStatusText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="120" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings_QuietHours}" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings_QuietHoursDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,24,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"><Label Content="{DynamicResource Settings_Start}" /><TextBox Text="{Binding Settings.QuietHoursStart}" /></StackPanel>
                                <StackPanel Grid.Column="3"><Label Content="{DynamicResource Settings_End}" /><TextBox Text="{Binding Settings.QuietHoursEnd}" /></StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="240,22,0,0">
                                <Button Content="{DynamicResource Settings_Save}" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                                <Button Content="{DynamicResource Settings_TestNotification}" Click="TestNotification_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Column="1" Height="3" VerticalAlignment="Top" Background="{StaticResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Height="3" />
        </Border>
    </Grid>
</Window>
