<Window x:Class="OhMyPc.App.Dialogs.ProxyModelImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProxyImportDialog_Title}"
        Width="820"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="22,20,22,0">
            <TextBlock Text="{DynamicResource ProxyImportDialog_Title}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock x:Name="ProviderTitleText" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{DynamicResource ProxyImportDialog_Hint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,14,22,10">
            <Button Content="{DynamicResource ProxyImportDialog_SelectAll}" Click="SelectAll_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource ProxyImportDialog_SelectNone}" Click="SelectNone_Click" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  Margin="22,0,22,0"
                  x:Name="RowsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnModel]}" Width="1.6*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Id}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{DynamicResource ProxyImportDialog_Exists}"
                                           Style="{StaticResource MutedText}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Exists, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnContext]}"
                                    Binding="{Binding ContextText}"
                                    Width="90" />
                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnLevels]}"
                                    Binding="{Binding LevelsText}"
                                    Width="1.2*" />
                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnModalities]}"
                                    Binding="{Binding ModalitiesText}"
                                    Width="1.1*" />
                <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Proxy_ColumnCost]}"
                                    Binding="{Binding CostText}"
                                    Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14"
                Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{DynamicResource ProxyImportDialog_Import}" Style="{StaticResource PrimaryButton}" Click="Import_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
