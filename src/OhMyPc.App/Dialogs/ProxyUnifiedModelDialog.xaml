<Window x:Class="OhMyPc.App.Dialogs.ProxyUnifiedModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProxyUnifiedDialog_Title}"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <StackPanel Margin="24,22,24,84">
            <TextBlock x:Name="ModelNameText" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ProviderCountText" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            <TextBlock Text="{DynamicResource ProxyUnifiedDialog_Hint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />

            <StackPanel Margin="0,18,0,16">
                <Label Content="{DynamicResource Proxy_ModelContext}" />
                <TextBox x:Name="ContextBox" Width="180" HorizontalAlignment="Left" />
            </StackPanel>

            <Label Content="{DynamicResource ProxyModelDialog_Levels}" Margin="0,0,0,6" />
            <WrapPanel x:Name="LevelsPanel" Margin="0,0,0,14" />

            <Label Content="{DynamicResource ProxyModelDialog_InputModalities}" Margin="0,0,0,6" />
            <WrapPanel x:Name="InputPanel" Margin="0,0,0,14" />

            <Label Content="{DynamicResource ProxyModelDialog_OutputModalities}" Margin="0,0,0,6" />
            <WrapPanel x:Name="OutputPanel" />
        </StackPanel>

        <Border VerticalAlignment="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{DynamicResource ProxyUnifiedDialog_Apply}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
