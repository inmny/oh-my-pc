<Window x:Class="OhMyPc.App.Dialogs.ProxyModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProxyModelDialog_Title}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <StackPanel Margin="24,22,24,80">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="{DynamicResource Proxy_ModelName}" />
                    <TextBox x:Name="NameBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="{DynamicResource Proxy_ModelAlias}" />
                    <TextBox x:Name="AliasBox" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,16">
                <Label Content="{DynamicResource Proxy_ModelContext}" />
                <TextBox x:Name="ContextBox" Width="180" HorizontalAlignment="Left" />
            </StackPanel>

            <Label Content="{DynamicResource Proxy_CostSection}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="{DynamicResource Proxy_CostInput}" FontSize="11" Padding="0,0,0,4" />
                    <TextBox x:Name="CostInputBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="{DynamicResource Proxy_CostOutput}" FontSize="11" Padding="0,0,0,4" />
                    <TextBox x:Name="CostOutputBox" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <Label Content="{DynamicResource Proxy_CostCacheRead}" FontSize="11" Padding="0,0,0,4" />
                    <TextBox x:Name="CostCacheReadBox" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <Label Content="{DynamicResource Proxy_CostCacheWrite}" FontSize="11" Padding="0,0,0,4" />
                    <TextBox x:Name="CostCacheWriteBox" />
                </StackPanel>
            </Grid>

            <Label Content="{DynamicResource ProxyModelDialog_Levels}" Margin="0,0,0,6" />
            <WrapPanel x:Name="LevelsPanel" Margin="0,0,0,14" />

            <Label Content="{DynamicResource ProxyModelDialog_InputModalities}" Margin="0,0,0,6" />
            <WrapPanel x:Name="InputPanel" Margin="0,0,0,14" />

            <Label Content="{DynamicResource ProxyModelDialog_OutputModalities}" Margin="0,0,0,6" />
            <WrapPanel x:Name="OutputPanel" />
        </StackPanel>

        <Border VerticalAlignment="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{DynamicResource ProxyModelDialog_Save}" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
