<Window x:Class="OhMyPc.App.Dialogs.DshImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dsh_ImportTitle}"
        Width="480"
        Height="480"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Dsh_ImportTitle}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Dsh_ImportDescription}" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 主题无 ListBox 隐式样式：用主题化 Border + CheckBox 的 ItemsControl，避免默认白底 -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EntryList" Margin="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PanelRaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12,8"
                                    Margin="0,3">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=TwoWay}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="ImportButton"
                    Content="{DynamicResource Dsh_ImportButton}"
                    Style="{StaticResource PrimaryButton}"
                    Click="Import_Click" />
        </StackPanel>
    </Grid>
</Window>
