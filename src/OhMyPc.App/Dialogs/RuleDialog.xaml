<Window x:Class="OhMyPc.App.Dialogs.RuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RuleDialog_Title}"
        Width="760"
        Height="760"
        MinHeight="620"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,24,26,88">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Label Content="{DynamicResource Common_Name}" />
                        <TextBox x:Name="NameBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="{DynamicResource RuleDialog_Event}" />
                        <ComboBox x:Name="EventBox"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="EventBox_SelectionChanged" />
                    </StackPanel>
                </Grid>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource RuleDialog_Conditions}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{StaticResource InputBrush}" CornerRadius="4" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MatchAllBox"
                                                 GroupName="ConditionMatchMode"
                                                 Content="{DynamicResource RuleDialog_MatchAll}"
                                                 Style="{StaticResource SegmentButton}" />
                                    <RadioButton x:Name="MatchAnyBox"
                                                 GroupName="ConditionMatchMode"
                                                 Content="{DynamicResource RuleDialog_MatchAny}"
                                                 Style="{StaticResource SegmentButton}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="ConditionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="1.05*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Fields}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                                  SelectionChanged="ConditionField_SelectionChanged" />
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Operators}"
                                                  SelectedItem="{Binding SelectedOperator, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" />
                                        <Grid Grid.Column="4">
                                            <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsesTextInput}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <ComboBox ItemsSource="{Binding Options}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding ValueText, Mode=TwoWay}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsesOptionPicker}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                        </Grid>
                                        <Button Grid.Column="6"
                                                Content="&#xE711;"
                                                FontFamily="Segoe Fluent Icons"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="{DynamicResource RuleDialog_RemoveCondition}"
                                                Click="RemoveCondition_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button HorizontalAlignment="Left" Click="AddCondition_Click" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource RuleDialog_AddCondition}" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="OptionsStatusText"
                                   Style="{StaticResource MutedText}"
                                   Foreground="{StaticResource CriticalBrush}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource RuleDialog_Action}" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="{DynamicResource RuleDialog_Severity}" />
                                <ComboBox x:Name="SeverityBox" ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="{DynamicResource Header_Channels}" />
                                <WrapPanel Margin="0,7,0,0">
                                    <CheckBox x:Name="DanmakuBox" Content="{DynamicResource RuleDialog_Danmaku}" Margin="0,0,20,0" />
                                    <CheckBox x:Name="SystemBox" Content="{DynamicResource RuleDialog_System}" Margin="0,0,20,0" />
                                    <CheckBox x:Name="TrayBox" Content="{DynamicResource RuleDialog_Tray}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,22,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="{DynamicResource RuleDialog_Cooldown}" />
                            <TextBox x:Name="CooldownBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,5">
                            <CheckBox x:Name="QuietHoursBox" Content="{DynamicResource RuleDialog_RespectQuietHours}" Margin="0,0,0,12" />
                            <CheckBox x:Name="EnabledBox" Content="{DynamicResource Common_Enabled}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border VerticalAlignment="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{DynamicResource RuleDialog_Save}" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
