<Window x:Class="OhMyPc.App.Dialogs.VpnLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Vpn_LoginTitle}"
        Width="440"
        Height="340"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Vpn_LoginHeading}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Vpn_LoginDescription}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <Label Content="{DynamicResource Vpn_Email}" />
            <TextBox x:Name="EmailBox" />
        </StackPanel>
        <StackPanel Grid.Row="4">
            <Label Content="{DynamicResource Vpn_Password}" />
            <PasswordBox x:Name="PasswordBox" />
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Vpn_Connect}" Style="{StaticResource PrimaryButton}" Click="Connect_Click" />
        </StackPanel>
    </Grid>
</Window>
