<Window x:Class="OhMyPc.App.Dialogs.SourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SourceDialog_Title}"
        Width="500"
        Height="570"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="14" />
            <RowDefinition Height="Auto" /><RowDefinition Height="14" />
            <RowDefinition Height="Auto" /><RowDefinition Height="14" />
            <RowDefinition Height="Auto" /><RowDefinition Height="14" />
            <RowDefinition Height="Auto" /><RowDefinition Height="14" />
            <RowDefinition Height="Auto" /><RowDefinition Height="14" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"><Label Content="{DynamicResource Common_Name}" /><TextBox x:Name="NameBox" /></StackPanel>
        <StackPanel Grid.Row="2"><Label Content="{DynamicResource SourceDialog_ProviderType}" /><ComboBox x:Name="KindBox" ItemTemplate="{StaticResource LocalizedEnumItemTemplate}" SelectionChanged="KindBox_SelectionChanged" /></StackPanel>
        <StackPanel Grid.Row="4"><Label Content="{DynamicResource Header_BaseUrl}" /><TextBox x:Name="BaseUrlBox" /></StackPanel>
        <StackPanel Grid.Row="6">
            <Label Content="{DynamicResource SourceDialog_ModelStatusUrl}" />
            <TextBox x:Name="ModelStatusUrlBox" />
            <TextBlock Text="{DynamicResource SourceDialog_ModelStatusUrlHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="8">
            <Label Content="{DynamicResource SourceDialog_ApiKey}" />
            <PasswordBox x:Name="ApiKeyBox" />
            <TextBlock Text="{DynamicResource SourceDialog_KeyHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="10"><Label Content="{DynamicResource SourceDialog_PollInterval}" /><TextBox x:Name="IntervalBox" /></StackPanel>
        <CheckBox Grid.Row="12" x:Name="EnabledBox" Content="{DynamicResource Common_Enabled}" />

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="{DynamicResource SourceDialog_Save}" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
