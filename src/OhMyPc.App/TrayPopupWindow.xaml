<Window x:Class="OhMyPc.App.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="370"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="{StaticResource TraySurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OH MY PC" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="{DynamicResource Overview_RefreshTooltip}" />
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Overview_TodayTokens}" Style="{StaticResource MutedText}" FontSize="10" />
                        <TextBlock Text="{Binding TodayTokensText}" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                        <TextBlock Text="{DynamicResource Header_Cost}" Style="{StaticResource MutedText}" FontSize="10" />
                        <TextBlock Text="{Binding TodayCostText}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="{StaticResource PanelRaisedBrush}" CornerRadius="4" Padding="12,10" Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Vpn.HasAccount}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Tray_VpnTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Vpn.PlanName}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Vpn.RemainingPercentText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Vpn.RemainingText}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Vpn.DaysRemainingText}" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                    </Grid>
                    <ProgressBar Grid.Row="2" Value="{Binding Vpn.RemainingPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,8,0,0" />
                </Grid>
            </Border>
            <TextBlock Grid.Row="5" Text="{DynamicResource Overview_CurrentQuotas}" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ScrollViewer Grid.Row="6"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl ItemsSource="{Binding QuotaRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,5,13">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" FontSize="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RemainingText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding PercentText}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding RemainingPercent, Mode=OneWay}" Maximum="100" Margin="0,7,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Grid.Row="7" Content="{DynamicResource Tray_OpenDashboardButton}" Style="{StaticResource PrimaryButton}" Click="OpenDashboard_Click" Margin="0,14,0,0" />
        </Grid>
    </Border>
</Window>
