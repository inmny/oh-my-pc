<UserControl x:Class="OhMyPc.App.Views.DshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid Margin="28,0,28,28" MaxWidth="940" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 页头 -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dsh_Title}" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{DynamicResource Dsh_Description}" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding Dsh.LatestVersionText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0"
                                   Visibility="{Binding Dsh.HasLatestVersion, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Click="AddServer_Click" Content="{DynamicResource Dsh_AddServer}" />
                <Button Grid.Column="3" Click="ImportServers_Click" Content="{DynamicResource Dsh_ImportFromSsh}" />
                <Button Grid.Column="5"
                        Command="{Binding Dsh.RefreshCommand}"
                        Content="&#xE72C;"
                        ToolTip="{DynamicResource Common_Refresh}"
                        Style="{StaticResource IconButton}" />
            </Grid>

            <!-- 本机实例卡片 -->
            <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Dsh_Local}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Dsh.LocalStateText}" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dsh.LocalHasError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Dsh.LocalVersionText}" Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Label Content="{DynamicResource Dsh_FieldPort}" VerticalAlignment="Center" />
                            <TextBox Text="{Binding Dsh.LocalPortText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Width="90"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Dsh.LocalPanelUrl}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Dsh.HasLocalPanelUrl, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding Dsh.StartLocalCommand}"
                                IsEnabled="{Binding Dsh.CanStartLocal}"
                                Content="{DynamicResource Dsh_Start}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Command="{Binding Dsh.RestartLocalCommand}"
                                IsEnabled="{Binding Dsh.CanStopLocal}"
                                Content="{DynamicResource Dsh_Restart}"
                                Margin="0,0,8,0" />
                        <Button Command="{Binding Dsh.StopLocalCommand}"
                                IsEnabled="{Binding Dsh.CanStopLocal}"
                                Content="{DynamicResource Dsh_Stop}"
                                Margin="0,0,8,0" />
                        <Button Command="{Binding Dsh.OpenLocalPanelCommand}"
                                IsEnabled="{Binding Dsh.HasLocalPanelUrl}"
                                Content="{DynamicResource Dsh_OpenPanel}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 服务器列表 -->
            <Grid Grid.Row="2" Margin="0,24,0,10">
                <TextBlock Text="{DynamicResource Dsh_ServersTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="3">
                <TextBlock Text="{DynamicResource Dsh_NoServers}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Visibility="{Binding Dsh.HasServers, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding Dsh.Servers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PanelCard}" Padding="18,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="4,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTunneled}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding HostText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding PortsText}" Style="{StaticResource MutedText}" FontSize="11" />
                                            <TextBlock Text="{Binding LocalPanelUrl}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="11"
                                                       Margin="12,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="420"
                                                       Visibility="{Binding LocalPanelUrl, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource CriticalBrush}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ShowStatusError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Margin" Value="0,0,6,0" />
                                                <Setter Property="Padding" Value="9,3" />
                                                <Setter Property="MinWidth" Value="0" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <Button Content="{DynamicResource Dsh_Probe}" Command="{Binding ProbeCommand}" />
                                        <Button Content="{DynamicResource Dsh_Install}" Command="{Binding InstallCommand}" />
                                        <Button Content="{DynamicResource Dsh_Update}" Command="{Binding UpdateCommand}" />
                                        <Button Content="{DynamicResource Dsh_Start}" Command="{Binding StartRemoteCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Margin" Value="0,0,6,0" />
                                                    <Setter Property="Padding" Value="9,3" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource Dsh_Stop}" Command="{Binding StopRemoteCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Margin" Value="0,0,6,0" />
                                                    <Setter Property="Padding" Value="9,3" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- 打开：已转发时直接复用隧道，未转发时自动建立 -->
                                        <Button Command="{Binding OpenTunnelCommand}"
                                                Content="{DynamicResource Dsh_ForwardOpen}"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,6,0"
                                                Padding="9,3"
                                                MinWidth="0" />
                                        <Button Content="{DynamicResource Dsh_CloseTunnel}" Command="{Binding CloseTunnelCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Margin" Value="0,0,6,0" />
                                                    <Setter Property="Padding" Value="9,3" />
                                                    <Setter Property="MinWidth" Value="0" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTunneled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource Dsh_SyncConfig}" Click="SyncServer_Click" />
                                        <Button Content="&#xE70F;" Click="EditServer_Click" ToolTip="{DynamicResource Common_Edit}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Margin" Value="0,0,4,0" />
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xE74D;" Click="DeleteServer_Click" ToolTip="{DynamicResource Common_Delete}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 操作日志 -->
            <Border Grid.Row="4" Style="{StaticResource PanelCard}" Padding="14" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Dsh_LogTitle}" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,6" />
                    <ListBox x:Name="LogList"
                             Grid.Row="1"
                             ItemsSource="{Binding Dsh.LogLines}"
                             FontFamily="Consolas"
                             FontSize="11.5"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <!-- 主题无 ListBox 隐式样式：去掉默认的选中蓝条，日志行只作展示 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
