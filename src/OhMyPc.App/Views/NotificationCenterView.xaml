<UserControl x:Class="OhMyPc.App.Views.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:OhMyPc.Core.Domain;assembly=OhMyPc.Core">
    <Grid Margin="28,0,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource NotificationCenter_Title}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{DynamicResource NotificationCenter_Description}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="4" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{DynamicResource NotificationCenter_HistoryTab}"
                                 GroupName="NotificationCenterSection"
                                 Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding NotificationCenter.IsHistorySelected, Mode=TwoWay}" />
                    <RadioButton Content="{DynamicResource NotificationCenter_RulesTab}"
                                 GroupName="NotificationCenterSection"
                                 Style="{StaticResource SegmentButton}"
                                 IsChecked="{Binding NotificationCenter.IsRulesSelected, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="2"
                       Text="{Binding NotificationCenter.HistoryCountText}"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       Visibility="{Binding NotificationCenter.IsHistorySelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Grid Grid.Row="2"
              Visibility="{Binding NotificationCenter.IsHistorySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding NotificationCenter.SourceOptions}"
                          SelectedItem="{Binding NotificationCenter.SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="NotificationFilter_SelectionChanged"
                          ToolTip="{DynamicResource NotificationCenter_SourceFilter}" />
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding NotificationCenter.SeverityOptions}"
                          SelectedItem="{Binding NotificationCenter.SelectedSeverity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="NotificationFilter_SelectionChanged"
                          ToolTip="{DynamicResource NotificationCenter_SeverityFilter}" />
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding NotificationCenter.PeriodOptions}"
                          SelectedItem="{Binding NotificationCenter.SelectedPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="NotificationFilter_SelectionChanged"
                          ToolTip="{DynamicResource NotificationCenter_PeriodFilter}" />
                <Button Grid.Column="6"
                        Content="&#xE72C;"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource NotificationCenter_RefreshTooltip}"
                        Click="RefreshNotificationHistory_Click" />
                <Button Grid.Column="8"
                        Content="&#xE768;"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource NotificationCenter_ReplayTooltip}"
                        IsEnabled="{Binding NotificationCenter.HasSelectedNotification}"
                        Click="ReplayNotification_Click" />
                <Button Grid.Column="10"
                        Content="&#xE74D;"
                        Style="{StaticResource IconButton}"
                        ToolTip="{DynamicResource NotificationCenter_DeleteTooltip}"
                        IsEnabled="{Binding NotificationCenter.HasSelectedNotification}"
                        Click="DeleteNotification_Click" />
                <Button Grid.Column="12"
                        Content="{DynamicResource NotificationCenter_ClearAll}"
                        Style="{StaticResource DangerButton}"
                        Click="ClearNotificationHistory_Click" />
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource CriticalBrush}"
                    BorderThickness="3,0,0,0"
                    Background="{DynamicResource PanelRaisedBrush}"
                    Padding="12,9"
                    Margin="0,0,0,12"
                    Visibility="{Binding NotificationCenter.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding NotificationCenter.ErrorText}" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2">
                <DataGrid ItemsSource="{Binding NotificationCenter.Notifications}"
                          SelectedItem="{Binding NotificationCenter.SelectedNotification, Mode=TwoWay}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_Time]}"
                                            Binding="{Binding CreatedAtText}"
                                            Width="148" />
                        <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_Source]}"
                                            Binding="{Binding SourceText}"
                                            Width="170" />
                        <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_Severity]}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static domain:NotificationSeverity.Warning}">
                                                            <Setter Property="Fill" Value="{DynamicResource AmberBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static domain:NotificationSeverity.Critical}">
                                                            <Setter Property="Fill" Value="{DynamicResource CriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SeverityText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_TitleColumn]}" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{Binding Source={StaticResource Localization}, Path=[NotificationCenter_Body]}" Width="1.7*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Body}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Channels]}"
                                            Binding="{Binding ChannelsText}"
                                            Width="118" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding NotificationCenter.IsHistoryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource NotificationCenter_Empty}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    Style="{StaticResource PanelCard}"
                    Padding="14,12"
                    Margin="0,12,0,0"
                    MaxHeight="150"
                    Visibility="{Binding NotificationCenter.HasSelectedNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NotificationCenter.SelectedNotification.Title}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding NotificationCenter.SelectedNotification.CreatedAtText}"
                                   Style="{StaticResource MutedText}"
                                   Margin="16,0,0,0" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding NotificationCenter.SelectedNotification.Body}" TextWrapping="Wrap" Margin="0,0,18,0" />
                        </ScrollViewer>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding NotificationCenter.SelectedNotification.SourceText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NotificationCenter.SelectedNotification.SeverityText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding NotificationCenter.SelectedNotification.ChannelsText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Visibility="{Binding NotificationCenter.IsRulesSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource NotificationCenter_RulesDescription}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{DynamicResource Rules_Add}" Click="AddRule_Click" Style="{StaticResource PrimaryButton}" />
                <Button Grid.Column="3" Content="{DynamicResource Common_Edit}" Click="EditRule_Click" IsEnabled="{Binding NotificationCenter.HasSelectedRule}" />
                <Button Grid.Column="5" Content="{DynamicResource Common_Delete}" Click="DeleteRule_Click" Style="{StaticResource DangerButton}" IsEnabled="{Binding NotificationCenter.HasSelectedRule}" />
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding NotificationCenter.Rules}" SelectedItem="{Binding NotificationCenter.SelectedRule, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Common_Name]}" Binding="{Binding Converter={StaticResource LocalizedRuleNameConverter}}" Width="1.5*" />
                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Event]}" Binding="{Binding EventType, Converter={StaticResource LocalizedAutomationEventConverter}}" Width="1.25*" />
                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Conditions]}" Binding="{Binding Converter={StaticResource AutomationConditionsConverter}}" Width="2.3*" />
                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Channels]}" Binding="{Binding Converter={StaticResource AutomationChannelsConverter}}" Width="1.1*" />
                    <DataGridTextColumn Header="{Binding Source={StaticResource Localization}, Path=[Header_Cooldown]}" Binding="{Binding CooldownMinutes}" Width="140" />
                    <DataGridCheckBoxColumn Header="{Binding Source={StaticResource Localization}, Path=[Common_Enabled]}" Binding="{Binding Enabled}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
