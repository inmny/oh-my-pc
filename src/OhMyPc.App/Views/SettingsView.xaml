<UserControl x:Class="OhMyPc.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,0,28,28"
              MaxWidth="760"
              HorizontalAlignment="Left"
              IsEnabled="{Binding CanEditSettings}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource Settings_Title}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource Settings_Description}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,18" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Application}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Settings_ApplicationDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,24,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Settings_Language}" Margin="0,0,0,6" />
                        <ComboBox SelectedValue="{Binding Settings.Language}" SelectedValuePath="Tag" Width="180" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Tag="zh-CN" Content="{DynamicResource Language_ZhCN}" />
                            <ComboBoxItem Tag="en-US" Content="{DynamicResource Language_EnUS}" />
                        </ComboBox>
                        <TextBlock Text="{DynamicResource Settings_Theme}" Margin="0,0,0,6" />
                        <ComboBox SelectedValue="{Binding Settings.Theme}" SelectedValuePath="Tag" Width="180" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <ComboBoxItem Tag="omp-dark" Content="{DynamicResource Settings_ThemeOmpDark}" />
                            <ComboBoxItem Tag="github-light" Content="{DynamicResource Settings_ThemeGitHubLight}" />
                            <ComboBoxItem Tag="github-dark" Content="{DynamicResource Settings_ThemeGitHubDark}" />
                            <ComboBoxItem Tag="one-light" Content="{DynamicResource Settings_ThemeOneLight}" />
                            <ComboBoxItem Tag="one-dark" Content="{DynamicResource Settings_ThemeOneDark}" />
                            <ComboBoxItem Tag="claude-light" Content="{DynamicResource Settings_ThemeClaudeLight}" />
                            <ComboBoxItem Tag="claude-dark" Content="{DynamicResource Settings_ThemeClaudeDark}" />
                        </ComboBox>
                        <CheckBox Content="{DynamicResource Settings_StartWithWindows}" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,0,0,12" />
                        <CheckBox Content="{DynamicResource Settings_CliProxyAutoStart}" IsChecked="{Binding Settings.CliProxyAutoStart}" Margin="0,0,0,12" />
                        <CheckBox Content="{DynamicResource Settings_UpdateCheck}" IsChecked="{Binding Settings.UpdateCheckEnabled}" Margin="0,0,0,12" />
                        <CheckBox Content="{DynamicResource Settings_EnableNotifications}" IsChecked="{Binding Settings.NotificationsEnabled}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="{DynamicResource Settings_Version}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding AppVersionText}" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Settings_NotificationRetention}" Margin="0,16,0,6" />
                        <ComboBox SelectedValue="{Binding Settings.NotificationHistoryRetentionDays, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Width="180"
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="{DynamicResource Settings_Retention7Days}">
                                <ComboBoxItem.Tag><sys:Int32>7</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="{DynamicResource Settings_Retention30Days}">
                                <ComboBoxItem.Tag><sys:Int32>30</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                            <ComboBoxItem Content="{DynamicResource Settings_Retention90Days}">
                                <ComboBoxItem.Tag><sys:Int32>90</sys:Int32></ComboBoxItem.Tag>
                            </ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Danmaku}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Settings_DanmakuDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,24,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <CheckBox Content="{DynamicResource Settings_EnableDanmaku}" IsChecked="{Binding Settings.DanmakuEnabled}" Margin="0,0,0,8" />
                            <CheckBox Content="{DynamicResource Settings_HoldWhenAway}" IsChecked="{Binding Settings.DanmakuHoldWhenAway}" Margin="0,0,0,14" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_Opacity}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Settings.DanmakuOpacity, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_Speed}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Settings.DanmakuSpeed, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_FontSize}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Settings.DanmakuFontSize, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_MaxDuration}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Settings.DanmakuDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_LocalApi}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Settings_LocalApiDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,24,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox Content="{DynamicResource Settings_EnableLocalApi}" IsChecked="{Binding Settings.LocalApiEnabled}" Margin="0,0,0,14" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Settings_LocalApiPort}" VerticalAlignment="Center" />
                            <TextBox x:Name="LocalApiPortBox"
                                     Grid.Column="1"
                                     Text="{Binding Settings.LocalApiPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Settings_LocalApiEndpoint}" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Text="{Binding LocalApiStatusText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="120" /><ColumnDefinition Width="12" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_QuietHours}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Settings_QuietHoursDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,24,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"><Label Content="{DynamicResource Settings_Start}" /><TextBox Text="{Binding Settings.QuietHoursStart}" /></StackPanel>
                    <StackPanel Grid.Column="3"><Label Content="{DynamicResource Settings_End}" /><TextBox Text="{Binding Settings.QuietHoursEnd}" /></StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="240,22,0,0">
                    <Button Content="{DynamicResource Settings_Save}" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                    <Button Content="{DynamicResource Settings_TestNotification}" Click="TestNotification_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
